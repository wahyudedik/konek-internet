# ============================================
# Konektivitas.com — Environment Variables
# ============================================
# Copy file ini ke .env dan isi values yang sesuai.
# Deploy script (deploy.sh) akan generate .env secara otomatis.

# App
APP_NAME=Konektivitas.com
APP_VERSION=1.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000

# Redis
# Format: redis://:password@host:port/db
REDIS_URL=redis://localhost:6379/0

# Cache TTL (dalam detik)
CACHE_TTL=300

# Rate Limiting (requests per menit per IP)
RATE_LIMIT_PER_MINUTE=60

# CORS (pisahkan dengan koma jika multiple)
ALLOWED_ORIGINS=https://konektivitas.com,https://www.konektivitas.com

# API
API_V1_PREFIX=/api/v1

# Database
# SQLite (Fase 1-2): sqlite+aiosqlite:///./konektivitas.db
# PostgreSQL (Fase 3+): postgresql+asyncpg://user:pass@localhost:5432/konektivitas
DATABASE_URL=sqlite+aiosqlite:///./konektivitas.db

# JWT Authentication
# WAJIB diganti dengan secret random di production!
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP Email (untuk verifikasi email, notifikasi, dll)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@konektivitas.com

# Telegram Bot (opsional — untuk notifikasi monitoring)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Discord Webhook (opsional — untuk notifikasi monitoring)
DISCORD_WEBHOOK_URL=
